msgid "plugins.importexport.portico.displayName"
msgstr "Portico Export Plugin"

msgid "plugins.importexport.portico.description"
msgstr ""
"This plugin exports your journal content to the <a href=\"https://www.portico.org\" target=\"_blank\">"
"Portico digital preservation service</a>. Content may be downloaded for later delivery to "
"Portico, or delivered directly to your account on the Portico server by configuring your "
"credentials below."

msgid "plugins.importexport.portico.description.short"
msgstr "Export journal articles to the Portico digital preservation service."

msgid "plugins.importexport.portico.ftpLibraryMissing"
msgstr ""
"<blockquote style=\"border: 1px solid; padding: 1em;\"><strong>⚠️ Warning:</strong> "
"The <code>league/flysystem-ftp</code> library is missing from your server. To install it, run:\n"
"<pre><code>composer -d lib/pkp require league/flysystem-ftp</code></pre>"
"...or upgrade to a newer release of OJS. Until this is resolved, <strong>FTP deposits will not work</strong>. "
"SFTP, Portico, and Library of Congress deposits can still be used.</blockquote>"

msgid "plugins.importexport.portico.endpoint.type"
msgstr "Server Type"

msgid "plugins.importexport.portico.endpoint.hostname"
msgstr "Hostname"

msgid "plugins.importexport.portico.endpoint.username"
msgstr "Username"

msgid "plugins.importexport.portico.endpoint.password"
msgstr "Password"

msgid "plugins.importexport.portico.endpoint.path"
msgstr "Path"

msgid "plugins.importexport.portico.endpoint.private_key"
msgstr "Private Key Path"

msgid "plugins.importexport.portico.endpoint.keyphrase"
msgstr "Keyphrase (optional)"

msgid "plugins.importexport.portico.endpoint.port"
msgstr "Port (optional, SFTP defaults to 22, FTP to 21)"

msgid "plugins.importexport.portico.endpoint.authenticationType"
msgstr "Authentication Type"

msgid "plugins.importexport.portico.endpointNumber"
msgstr "Endpoint #{$number}"

msgid "plugins.importexport.portico.newEndpoint"
msgstr "New Endpoint"

msgid "plugins.importexport.portico.endpoint.delete"
msgstr "Delete this endpoint"

msgid "plugins.importexport.portico.manager.settings.required"
msgstr "Please provide complete details for each endpoint."

msgid "plugins.importexport.portico.manager.settings.automaticRegistrationRequiresEndpoint"
msgstr "Automatic registration requires at least one complete endpoint."

msgid "plugins.importexport.portico.submit.success"
msgstr "Articles submitted for delivery."

msgid "plugins.importexport.portico.settings.form.automaticRegistration.description"
msgstr ""
"OJS will deliver content to Portico automatically once it is published. Please note that this may "
"take a short amount of time after publication to process (e.g. depending on "
"your cronjob configuration). You can check for all undelivered content in the export tab."

msgid "plugins.importexport.portico.senderTask.name"
msgstr "Portico automatic delivery task"

msgid "plugins.importexport.portico.export.failure.settings"
msgstr "To deliver content to Portico you must set up at least one endpoint in the settings tab."

msgid "plugins.importexport.portico.export.failure.creatingFile"
msgstr "Failed to create the zip file for '{$param}'."

msgid "plugins.importexport.portico.export.failure.creatingCollectionFile"
msgstr "Failed to create the outer zip file for the export."

msgid "plugins.importexport.portico.export.failure.jatsTemplateUnavailable"
msgstr "Unable to generate the metadata XML for '{$param}': the JATS Template plugin is not installed or enabled."

msgid "plugins.importexport.portico.export.failure.noPdf"
msgstr "'{$param}' has no PDF galley. Portico requires a PDF, so it cannot be exported/deposited."

msgid "plugins.importexport.portico.export.failure.malformedFullText"
msgstr "The uploaded full-text JATS document for '{$param}' could not be parsed. Please check that it is well-formed XML."

msgid "plugins.generic.portico.displayName"
msgstr "Portico Plugin"

msgid "plugins.generic.portico.description"
msgstr "Exports and delivers articles or article versions to the Portico digital preservation service."
